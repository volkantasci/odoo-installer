services:
  web:
    image: {{ odoo_image }}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
{% if ingress_network %}
    networks:
      default: {}
      ingress:
        aliases:
          - {{ ingress_alias }}
{% else %}
    ports:
      - "{{ http_port }}:8069"
{% endif %}
    environment:
      DB_HOST: db
      DB_PORT: "5432"
      DB_USER: odoo
      DB_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./config:/etc/odoo
      - ./addons/local:/mnt/extra-addons
      - filestore:/var/lib/odoo
{% if memory_limit %}
    mem_limit: {{ memory_limit }}
{% endif %}
{% if cpus %}
    cpus: {{ cpus }}
{% endif %}
    command: ["odoo", "-c", "/etc/odoo/odoo.conf"]
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8069/web/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
  db:
    image: postgres:{{ pg_tag }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: postgres
      POSTGRES_USER: odoo
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo"]
      interval: 5s
      timeout: 5s
      retries: 30

volumes:
  pgdata:
  filestore:
{% if ingress_network %}

networks:
  ingress:
    external: true
    name: {{ ingress_network }}
{% endif %}
